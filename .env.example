# Postgres connection string (Supabase: Project Settings > Database > Connection pooling URI; or Neon pooled URL)
DATABASE_URL=
# Long random string used to sign the admin session cookie (required in production)
AUTH_SECRET=
# Supabase Auth (admin sign-in): Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase email(s) allowed to become the admin on first login. Also turn OFF public sign-ups in Supabase > Authentication.
ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=https://www.example.com
